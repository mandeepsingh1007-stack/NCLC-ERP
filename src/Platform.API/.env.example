# Platform API — Environment Variables (Development)
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.

# PostgreSQL connection string
ConnectionStrings__Default=Host=localhost;Port=5432;Database=NCLC;Username=postgres;Password=YOUR_PASSWORD

# Redis connection
Redis__ConnectionString=localhost:6379

# JWT settings (configure in Phase 1/5)
# Jwt__Key=<strong-random-key-min-32-chars>
# Jwt__Issuer=https://localhost:5001
# Jwt__Audience=https://localhost:3000
# Jwt__ExpiryMinutes=60
